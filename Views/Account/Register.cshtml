@model BookingSystemMVC.Controllers.AccountController.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<h2>Registrera</h2>

<form method="post" asp-action="Register">
    <div class="mb-3">
        <label class="form-label">Fullt namn</label>
        <input class="form-control" name="FullName" />
    </div>
    <div class="mb-3">
        <label class="form-label">E-post</label>
        <input class="form-control" name="Email" />
    </div>
    <div class="mb-3">
        <label class="form-label">Lösenord</label>
        <input type="password" class="form-control" name="Password" />
    </div>
    <div class="mb-3">
        <label class="form-label">Bekräfta lösenord</label>
        <input type="password" class="form-control" name="ConfirmPassword" />
    </div>
    <button class="btn btn-primary" type="submit">Registrera</button>
</form>
