@model IEnumerable<BookingSystemMVC.Booking.Models.Booking>
@{
    ViewData["Title"] = "Mina bokningar";
}

<h1>Mina bokningar</h1>

<table class="table">
    <thead>
        <tr>
            <th>Tjänst</th>
            <th>Start</th>
            <th>Varaktighet</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var b in Model)
    {
        <tr>
            <td>@b.Service?.Name</td>
            <td>@b.StartDateTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>@b.DurationMinutes min</td>
            <td>@b.Status</td>
        </tr>
    }
    </tbody>
</table>
