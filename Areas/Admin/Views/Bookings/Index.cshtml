@model IEnumerable<BookingSystemMVC.Booking.Models.Booking>
@{
    ViewData["Title"] = "Alla bokningar";
}

<h1>Alla bokningar</h1>
<table class="table">
    <thead>
        <tr><th>Användare</th><th>Tjänst</th><th>Start</th><th>Varaktighet</th><th>Status</th></tr>
    </thead>
    <tbody>
    @foreach(var b in Model)
    {
        <tr>
            <td>@b.UserId</td>
            <td>@b.Service?.Name</td>
            <td>@b.StartDateTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>@b.DurationMinutes</td>
            <td>@b.Status</td>
        </tr>
    }
    </tbody>
</table>
